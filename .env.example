# ============================================================
# Performe+ NFS-e — Variaveis de Ambiente
# ============================================================
# Middleware de emissao propria de NFS-e para a Performe+ (cursos).
# Fork do accel-nfse adaptado para deploy no Vercel + Firebase (cofre).
# Cole estes valores no painel do Vercel: Settings > Environment Variables.
# ============================================================

# === Servidor ===
PORT=3000
API_KEY=performe-nfse-2026-k3y-su3per-s3cr3t

# === Firebase (cofre do certificado A1) ===
# Crie um projeto no Firebase Console > Project Settings > Service Accounts
# Baixe a chave JSON e copie os campos abaixo.
# IMPORTANTE: na env var FIREBASE_PRIVATE_KEY, no Vercel:
#   1) Cole o conteudo completo de "private_key" do JSON, incluindo as duas linhas
#      -----BEGIN PRIVATE KEY-----\nMIIE...\n-----END PRIVATE KEY-----
#   2) Substitua as quebras de linha reais por \n literais (escape \n)
#      Ou salve como valor unico sem quebras (o config.js faz .replace(/\\n/g, '\n'))
FIREBASE_PROJECT_ID=performe-nfse-prod
FIREBASE_CLIENT_EMAIL=firebase-adminsdk@performe-nfse-prod.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIE...\n-----END PRIVATE KEY-----\n"
FIREBASE_CERT_COLLECTION=certificados
FIREBASE_CERT_DOC_ID=performe-a1

# === NFS-e ===
# Performe+ emite em Curitiba/PR (mesmo municipio da matriz Accel)
NFSE_UF=PR
NFSE_CIDADE=Curitiba
NFSE_CODIGO_IBGE=4106902
NFSE_TP_AMB=2                # 1=producao, 2=homologacao (comece em homologacao!)
NFSE_VER_APLIC=performemais_1.0.0
NFSE_SERIE=70000             # Serie nacional (Curitiba)
NFSE_STATUS_ON_ERROR=erro    # erro | pendente
# Inscricao Municipal da Performe+ (preencher apos cadastrar no CNC NFS-e da prefeitura)
NFSE_IM=
# Aliquota de ISS de Curitiba para cursos/treinamentos
NFSE_ALIQUOTA_ISS=5.00
# NBS padrao para cursos de TI/desenvolvimento (ja configurado nos produtos do Odoo)
NFSE_C_NBS=122051900
NFSE_C_TRIB_NAC=080201
NFSE_OP_SIMP_NAC=3           # 3=Simples Nacional
NFSE_P_TOT_TRIB_SN=6.00
NFSE_REG_AP_TRIB_SN=1
NFSE_REG_ESP_TRIB=0

# === Odoo (autenticacao via email + API Key) ===
# Gerar em: Odoo > Preferencias do usuario > Chaves de API
ODOO_ENABLED=1
ODOO_URL=https://performe.odoo.com
ODOO_DB=performe
ODOO_API_KEY=122307897e39fd4fd6119cecca38313cf7422d8b
ODOO_USER=paulo.yure@gmail.com
ODOO_POLLING_MS=15000
# Vercel Serverless: o setInterval NAO persiste entre invocacoes.
# Use o Cron integrado do Vercel (/api/cron/process-pending) ou um cron externo.
ODOO_CRON_MODE=1

# === SEFIN NFS-e (SPED v1.01, REST API com mTLS) ===
# Producao: https://sefin.nfse.gov.br/SefinNacional
# Homologacao (Producao Restrita): https://sefin.producaorestrita.nfse.gov.br/SefinNacional
SEFIN_PROD_URL=https://sefin.nfse.gov.br/SefinNacional
SEFIN_HOM_URL=https://sefin.producaorestrita.nfse.gov.br/SefinNacional

# === Seguranca ===
# NFSE_TLS_INSECURE=1    # Desativa validacao TLS (debug apenas)
# CRON_SECRET=           # Protege endpoint /api/cron/* (ver routes/cron.js)
