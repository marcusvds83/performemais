{
  "name": "performemais",
  "version": "1.0.0",
  "description": "Middleware de emissao propria de NFS-e/NF-e para Performe+ (cursos de venda) - SPED NFS-e v1.01 + NF-e SEFAZ. Fork do performemais adaptado para deploy no Vercel.",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "cron:process-pending": "node -e \"require('./services/nfse-odoo-emit').processPendingEmissions().then(r=>{console.log(JSON.stringify(r));process.exit(0);}).catch(e=>{console.error(e);process.exit(1);})\""
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "@xmldom/xmldom": "^0.9.5",
    "axios": "^1.7.0",
    "bwip-js": "^4.1.0",
    "cors": "^2.8.5",
    "express": "^4.21.0",
    "helmet": "^8.0.0",
    "multer": "^2.4.0",
    "node-forge": "^1.3.1",
    "pdfkit": "^0.15.0",
    "xml-crypto": "^6.1.2",
    "xml2js": "^0.6.2",
    "xmlrpc": "^1.3.2"
  }
}
